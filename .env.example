# Configure these values for exactly one network per service process.
RPC_URL=https://base-sepolia.blockpi.network/v1/rpc/753
EXPECTED_CHAIN_ID=84532
NETWORK_NAME=base-sepolia
NATIVE_SYMBOL=ETH
NATIVE_DECIMALS=18
RPC_PROVIDER_NAME=blockpi
RPC_TIMEOUT_SECONDS=10

# Optional ERC-20 endpoints: JSON address arrays for this network only.
# A non-empty token list restricts queries; [] permits any valid token address.
# Allowances always require an allowed spender; [] rejects every spender.
# No signing or transactions are enabled.
# Non-empty format example: ["0x1111111111111111111111111111111111111111"]
ERC20_ALLOWED_TOKENS=[]
ERC20_ALLOWED_SPENDERS=[]

# Optional: the LLM CLI and local investigation endpoint read these settings.
# Never commit real credentials.
LLM_API_KEY=sk-你的DeepSeek_API_Key
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_TLS_TRUST_STORE=certifi

LLM_TIMEOUT_SECONDS=30
LLM_RUN_TIMEOUT_SECONDS=60
LLM_MAX_MODEL_CALLS=4
LLM_MAX_TOOL_CALLS=4
LLM_MAX_OUTPUT_TOKENS=800
LLM_OUTPUT_TOKEN_BUDGET=2400
